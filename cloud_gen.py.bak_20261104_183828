#!/usr/bin/env python3
import os, sys, json, time, shutil, subprocess
from pathlib import Path

def main():
    if len(sys.argv) < 2:
        sys.exit(1)
    prompt = sys.argv[1]
    kfile = Path.home() / ".kaggle" / "kaggle.json"
    username = json.load(open(kfile))["username"]
    job_id = int(time.time())
    kernel_slug = f"{username}/cinema-gen-{job_id}"
    kdir = Path("var/cloud_job")
    kdir.mkdir(parents=True, exist_ok=True)
    
    gpu_script = f'''
import os, sys, subprocess
def log(msg): print(msg, flush=True)
log("⏳ [1/3] تثبيت المكتبات...")
subprocess.run([sys.executable, "-m", "pip", "install", "diffusers", "transformers", "accelerate", "sentencepiece", "imageio[ffmpeg]", "protobuf", "ftfy", "--use-deprecated=legacy-resolver"], capture_output=True)

import torch
from diffusers import WanPipeline
from diffusers.utils import export_to_video

os.environ["PYTORCH_CUDA_ALLOC_CONF"] = "expandable_segments:True"

log("⏳ [2/3] تحميل نموذج Wan 2.1 T2V-1.3B (خفيف ومناسب لـ T4)...")
pipe = WanPipeline.from_pretrained(
    "Wan-AI/Wan2.1-T2V-1.3B-Diffusers",
    torch_dtype=torch.float16
)
pipe.enable_model_cpu_offload()
if hasattr(pipe, "vae") and hasattr(pipe.vae, "enable_tiling"):
    pipe.vae.enable_tiling()
log("✅ تم تحميل النموذج")

log("🎬 [3/3] جاري توليد الفيديو...")
video = pipe(
    prompt={repr(prompt)},
    height=480,
    width=704,
    num_frames=81,
    num_inference_steps=25,
    guidance_scale=5.0,
    generator=torch.Generator(device="cuda").manual_seed(42)
).frames[0]

export_to_video(video, "/kaggle/working/output.mp4", fps=16)
log("SUCCESS")
'''
    (kdir / "script.py").write_text(gpu_script)
    meta = {"id": kernel_slug, "title": f"Cinema Gen {job_id}", "code_file": "script.py", "language": "python", "kernel_type": "script", "is_private": True, "enable_gpu": True, "enable_internet": True, "dataset_sources": [], "competition_sources": [], "kernel_sources": []}
    (kdir / "kernel-metadata.json").write_text(json.dumps(meta, indent=2))
    
    print("🚀 جاري إرسال المهمة...")
    subprocess.run(["kaggle", "kernels", "push", "-p", str(kdir)], check=True)
    print(f"✅ تم الإرسال: https://www.kaggle.com/code/{kernel_slug}")
    print("⏳ ننتظر الانتهاء (10-15 دقيقة)...")
    
    while True:
        r = subprocess.run(["kaggle", "kernels", "status", kernel_slug], capture_output=True, text=True)
        status = r.stdout.strip()
        if "complete" in status.lower():
            print("✅ اكتمل التوليد!")
            break
        elif "error" in status.lower() or "fail" in status.lower():
            print(f"❌ فشل! افحص السجلات: https://www.kaggle.com/code/{kernel_slug}")
            sys.exit(1)
        time.sleep(20)
    
    print("📥 جاري التنزيل...")
    out_dir = Path("var/generated")
    subprocess.run(["kaggle", "kernels", "output", kernel_slug, "-p", str(out_dir)])
    mp4s = list(out_dir.rglob("*.mp4"))
    if mp4s:
        target = Path("static/latest_generated.mp4")
        shutil.copy(mp4s[0], target)
        print(f"🎉 SUCCESS! الفيديو جاهز: http://127.0.0.1:8750/static/latest_generated.mp4")
    else:
        print("❌ لم يتم العثور على فيديو.")

if __name__ == "__main__":
    main()
